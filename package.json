{
  "name": "just-three-crumbs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "kill:3000": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "kill:next": "sh -c 'for p in 3000 3001; do lsof -ti:$p | xargs kill -9 2>/dev/null; done; exit 0'",
    "dev": "next dev -p 3000 --turbopack",
    "dev:webpack": "next dev -p 3000",
    "dev:alt": "next dev -p 3001 --turbopack",
    "dev:clean": "npm run clean && npm run kill:next && next dev -p 3000 --turbopack",
    "dev:clean:alt": "npm run clean && npm run kill:next && next dev -p 3001 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.487.0",
    "next": "15.3.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.21.0",
    "eslint-config-next": "15.2.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2"
  }
}
